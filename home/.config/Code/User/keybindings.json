[
    {
        "command": "workbench.action.focusActiveEditorGroup",
        "key": "ctrl+e",
        "when": "!editorTextFocus && !terminalFocus"
    },
    {
        "command": "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup",
        "key": "ctrl+,",
        "when": "!activeEditorGroupEmpty && !terminalFocus"
    },
    {
        "command": "workbench.action.quickOpenNavigateNextInEditorPicker",
        "key": "ctrl+,",
        "when": "inEditorsPicker && inQuickOpen"
    },
    {
        "command": "workbench.action.quickOpenLeastRecentlyUsedEditorInGroup",
        "key": "ctrl+shift+,",
        "when": "!activeEditorGroupEmpty && !terminalFocus"
    },
    {
        "command": "workbench.action.quickOpenNavigatePreviousInEditorPicker",
        "key": "ctrl+shift+,",
        "when": "inEditorsPicker && inQuickOpen"
    },
    {
        "command": "workbench.action.terminal.toggleTerminal",
        "key": "ctrl+j",
        "when": "terminal.active && !terminalFocus && (!editorTextFocus || !vim.active || vim.mode != 'Insert')"
    },
    {
        "command": "extension.vim_ctrl+j",
        "key": "ctrl+j",
        "when": "editorTextFocus && vim.active && vim.mode == 'Insert' && vim.use<C-j> && !inDebugRepl"
    },
    {
        "command": "workbench.action.terminal.new",
        "key": "ctrl+shift+j",
        "when": "(terminalProcessSupported || terminalWebExtensionContributedProfile) && !terminalFocus && (!editorTextFocus || !vim.active || vim.mode != 'Insert')"
    },
    {
        "command": "workbench.action.toggleMaximizedPanel",
        "key": "ctrl+'",
        "when": "!terminalFocus"
    },
    {
        "command": "workbench.action.quickOpen",
        "key": "ctrl+p",
        "when": "!terminalFocus"
    },
    {
        "command": "workbench.action.showCommands",
        "key": "ctrl+shift+p",
        "when": "!terminalFocus"
    },
    {
        "command": "editor.action.selectAll",
        "key": "ctrl+a",
        "when": "!editorTextFocus && !terminalFocus"
    },
    {
        "command": "editor.action.clipboardCopyAction",
