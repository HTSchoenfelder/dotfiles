#!/usr/bin/env bash

# JankyBorders is an optional two-state alternative to Hammerspoon's slot-aware
# focus/layout border model. Do not run both at the same time.
options=(
  style=round
  width=5.0
  hidpi=on
  active_color=0xffa6e3a1
  inactive_color=0xff585b70
  blacklist="Hammerspoon,Notification Center,Control Center,Spotlight"
)

borders "${options[@]}"
